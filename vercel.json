{
    "version": 2,
    "regions": ["fra1"],
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.1"
        },
        "api/nepal-news-cron.php": {
            "runtime": "vercel-php@0.7.1",
            "maxDuration": 120
        }
    },
    "redirects": [
        {
            "source": "/(.*)",
            "has": [{ "type": "host", "value": "www.swapnilupadhyay.com.np" }],
            "destination": "https://swapnilupadhyay.com.np/$1",
            "permanent": true
        }
    ],
    "routes": [
        {
            "src": "/whisper/(.*)",
            "dest": "/whisper/$1"
        },
        {
            "src": "/coi-serviceworker\\.js",
            "dest": "/coi-serviceworker.js"
        },
        {
            "src": "/build/(.*)",
            "dest": "/build/$1"
        },
        {
            "src": "/(favicon.*|apple-touch-icon.*|web-app-manifest.*|site\\.webmanifest|achievements\\.txt|robots\\.txt|fonts/.*|.*\\.svg|.*\\.png|.*\\.jpg|.*\\.woff2)",
            "dest": "/$1"
        },
        {
            "src": "/api/nepal-news/cron",
            "dest": "/api/nepal-news-cron.php"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "APP_URL": "https://swapnilupadhyay.com.np",

        "APP_CONFIG_CACHE": "/tmp/config.php",
        "APP_EVENTS_CACHE": "/tmp/events.php",
        "APP_PACKAGES_CACHE": "/tmp/packages.php",
        "APP_ROUTES_CACHE": "/tmp/routes.php",
        "APP_SERVICES_CACHE": "/tmp/services.php",
        "VIEW_COMPILED_PATH": "/tmp",

        "CACHE_DRIVER": "array",
        "LOG_CHANNEL": "stderr",
        "SESSION_DRIVER": "cookie"
    },
    "outputDirectory": "public",
    "crons": [
        {
            "path": "/api/nepal-news/cron",
            "schedule": "15 0 * * *"
        }
    ]
}
